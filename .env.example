# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Gemini API (for Flash-Lite - simple/router calls)
GEMINI_API_KEY=your_ai_studio_api_key

# Postgres
DATABASE_URL=postgresql://agent_user:agent_pass@localhost:5432/agent_db

# ChromaDB (local persistent store, just needs a folder)
CHROMA_PATH=./chroma_data

# Antigravity CLI - two Google accounts, isolated by separate HOME dirs
# so each keeps its own cached OAuth credentials.
ANTIGRAVITY_HOME_ACCOUNT_A=/home/agent/.antigravity-a
ANTIGRAVITY_HOME_ACCOUNT_B=/home/agent/.antigravity-b

# Retrieval tuning
MEMORY_TOP_K=5
MEMORY_SIMILARITY_THRESHOLD=0.5
